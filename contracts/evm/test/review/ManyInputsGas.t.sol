pragma solidity ^0.8.24;

import {TestBase} from "../TestBase.sol";
import {UtxoChainHarness} from "../Harness.sol";
import {Prevout} from "../../src/BtcTx.sol";

/// Review PoC: gas of a CLN-style wallet consolidation (N P2TR key-path
/// inputs, SIGHASH_DEFAULT, one output), built by gen_many.py. Logged gas is
/// the submit call's execution only (no 21,000 base, no calldata cost).
contract ManyInputsGasTest is TestBase {
    uint256 internal constant N = 300;
    bytes internal constant SPK = hex"5120989c0b76cb563971fdc9bef31ec06c3560f3249d6ee9e5d83c57625596e05f6f";
    bytes internal constant RAW = hex"";

    function testGasManyP2trInputs() public {
        vm.warp(1_700_000_000);
        UtxoChainHarness chain = new UtxoChainHarness(2);
        vm.deal(address(this), 100 ether);
        Prevout[] memory pv = new Prevout[](N);
        for (uint256 i; i < N; ++i) {
            pv[i] = Prevout(1000, SPK, 1);
            chain.seed{value: 1000 * 1e10}(bytes32(i + 1), 0, pv[i]);
        }
        vm.warp(1_700_000_000 + 5 * 2);
        bytes memory raw = RAW;
        uint256 g = gasleft();
        chain.submit(raw, pv);
        g -= gasleft();
        emit log_named_uint("inputs", N);
        emit log_named_uint("submit execution gas", g);
        emit log_named_uint("per input", g / N);
        emit log_named_uint("calldata bytes (abi)", abi.encodeCall(chain.submit, (raw, pv)).length);
    }
}
